# API Keys (Replace with your actual keys in .env.local)
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Cache Settings
CACHE_TTL=3600
CACHE_CHECK_PERIOD=120

# Database URL (for future use)
DATABASE_URL=postgresql://user:password@localhost:5432/vibe_checker 