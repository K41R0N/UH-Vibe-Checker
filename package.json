{
  "name": "vibe-checker",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.6.7"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"if(!require('fs').existsSync('node_modules/typescript')) { process.exit(1) }\" || npm install typescript @types/react @types/node",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "next telemetry disable",
    "clean": "rimraf .next out node_modules",
    "enrich": "ts-node --project tsconfig.scripts.json scripts/enrich-cities.ts",
    "enrich:test": "ts-node --project tsconfig.scripts.json scripts/enrich-cities.ts --limit 5 --verbose --dry-run",
    "enrich:city": "ts-node --project tsconfig.scripts.json scripts/enrich-cities.ts --city"
  },
  "dependencies": {
    "@types/node": "20.17.16",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "autoprefixer": "10.4.16",
    "axios": "1.7.9",
    "next": "14.0.4",
    "node-cache": "5.1.2",
    "postcss": "8.4.33",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.3"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.9.4",
    "ts-node": "10.9.2"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "18.2.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "main": "postcss.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
