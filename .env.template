# Required API Keys
# For local development only. In production, set these in Netlify dashboard:
# Site settings > Environment variables
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_api_key_here

# Cache Settings - Configure in Netlify dashboard
CACHE_TTL=3600
CACHE_CHECK_PERIOD=120

# Build Settings - Configure in Netlify dashboard
NODE_VERSION=18
NEXT_TELEMETRY_DISABLED=1

# Note: 
# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local to version control
# 3. For production, set all environment variables in Netlify dashboard

# Production Settings:
# Configure all environment variables in the Netlify dashboard:
# Site settings > Environment variables

# Development
NODE_ENV=development

# NOTE: API Keys should be configured in the Netlify dashboard:
# - NEXT_PUBLIC_OPENWEATHER_API_KEY
# - HUGGINGFACE_API_KEY 