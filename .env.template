# API Keys - Configure these in Netlify dashboard for production
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Cache Settings - Configure in Netlify dashboard
CACHE_TTL=3600
CACHE_CHECK_PERIOD=120

# Build Settings - Configure in Netlify dashboard
NODE_VERSION=18
NEXT_TELEMETRY_DISABLED=1

# Note: For local development:
# 1. Copy this file to .env.local
# 2. Add your development API keys
# 3. Never commit .env.local to the repository

# Production Settings:
# Configure all environment variables in the Netlify dashboard:
# Site settings > Environment variables

# Development
NODE_ENV=development

# NOTE: API Keys should be configured in the Netlify dashboard:
# - NEXT_PUBLIC_OPENWEATHER_API_KEY
# - HUGGINGFACE_API_KEY 